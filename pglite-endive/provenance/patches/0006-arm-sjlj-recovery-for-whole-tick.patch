+             * would otherwise never execute and the client hangs. */
+            if (is_wire && !ClientAuthInProgress && pq_buffer_remaining_data() > 0) {
+                peek = -1;
+                firstchar = 0;
+                goto incoming;
+            }
             goto return_early;
+        }
 
         firstchar = peek ;
 
@@ -570,12 +625,8 @@ PDEBUG("# 507: NO DATA:" PGS_IN  "\n");
         goto return_early;
     }
 
