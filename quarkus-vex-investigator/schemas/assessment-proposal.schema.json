{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VEX investigation proposal v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "test_only": {
      "type": "boolean"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "product_purl": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sbom_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vulnerability_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,160}$"
          },
          "component_purl": {
            "type": "string",
            "minLength": 1
          },
          "component_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_module": {
            "type": "string",
            "minLength": 1
          },
          "proposed_status": {
            "enum": [
              "under_investigation",
              "affected",
              "not_affected",
              "fixed"
            ]
          },
          "justification": {
            "type": [
              "string",
              "null"
            ]
          },
          "impact_statement": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_statement": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "sbom",
                    "advisory",
                    "findings",
                    "usage"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "type",
                "path",
                "sha256",
                "locator",
                "claim"
              ]
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommended_next_step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "vulnerability_id",
          "component_purl",
          "component_ref",
          "source_module",
          "proposed_status",
          "justification",
          "impact_statement",
          "action_statement",
          "reasoning",
          "evidence",
          "unknowns",
          "recommended_next_step"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "test_only",
    "case_id",
    "product_purl",
    "git_commit",
    "sbom_sha256",
    "assessments"
  ]
}
