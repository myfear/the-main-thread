{
  "realm": "delegation",
  "enabled": true,
  "displayName": "Cascaded delegation tutorial",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clientScopes": [
    {
      "name": "subject",
      "description": "Adds the stable user subject to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "identity",
      "description": "Adds the username used by the tutorial trace",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "preferred username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "to-service-a",
      "description": "Makes service-a available as an audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "service-a audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "service-a",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "to-service-b",
      "description": "Makes service-b available as an audience to service-a",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "service-b audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "service-b",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "to-service-c",
      "description": "Makes service-c available as an audience to service-b",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "service-c audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "service-c",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "forbidden",
      "description": "Optional scope used to prove that exchanges cannot expand scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "tutorial-client",
      "name": "Tutorial browser client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1:3000/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "subject",
        "identity",
        "to-service-a"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "service-a",
      "name": "Order Service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "service-a-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "subject",
        "identity",
        "to-service-b"
      ],
      "optionalClientScopes": [
        "forbidden"
      ]
    },
    {
      "clientId": "service-b",
      "name": "Inventory Service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "service-b-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "subject",
        "identity",
        "to-service-c"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "service-c",
      "name": "Audit Service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "service-c-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "subject",
        "identity"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "token-exchange-downscope",
        "description": "Prevent token exchange from adding scopes absent from the subject token",
        "executors": [
          {
            "executor": "downscope-assertion-grant-enforcer",
            "configuration": {}
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "token-exchange-only-downscope",
        "description": "Apply the downscope executor to RFC 8693 exchanges",
        "enabled": true,
        "conditions": [
          {
            "condition": "grant-type",
            "configuration": {
              "grant_types": [
                "urn:ietf:params:oauth:grant-type:token-exchange"
              ]
            }
          }
        ],
        "profiles": [
          "token-exchange-downscope"
        ]
      }
    ]
  }
}
