{
  "name": "software-city-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "test": "npm run check:types && vitest run",
    "build": "npm run check:types && tsc --noEmit && vite build",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/three": "0.186.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.0"
  }
}
