{
  "id": "loanflow",
  "realm": "loanflow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "loan_officer", "composite": false, "clientRole": false },
      { "name": "loan_admin", "composite": false, "clientRole": false },
      { "name": "offline_access", "composite": false, "clientRole": false },
      { "name": "uma_authorization", "composite": false, "clientRole": false },
      {
        "name": "default-roles-loanflow",
        "composite": true,
        "clientRole": false,
        "composites": { "realm": ["offline_access", "uma_authorization"] }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "roles",
      "description": "OpenID Connect scope for add user roles to the access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${rolesScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "name": "branch",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "branch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "branch",
            "claim.name": "branch",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "credit_check_run",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "document_write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "loanflow-cli",
      "name": "LoanFlow CLI",
      "enabled": true,
      "publicClient": false,
      "secret": "loanflow-cli-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "basic", "email", "branch"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "loan-service",
      "name": "Loan Service",
      "enabled": true,
      "publicClient": false,
      "secret": "loan-service-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["credit_check_run", "document_write"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Berlin",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["loan_officer", "default-roles-loanflow"],
      "attributes": { "branch": ["berlin"] }
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Hamburg",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["loan_officer", "default-roles-loanflow"],
      "attributes": { "branch": ["hamburg"] }
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "HQ",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["loan_admin", "default-roles-loanflow"],
      "attributes": { "branch": ["hq"] }
    }
  ]
}
