[Unit]
Description=Workshop model and Maven downloads
Wants=ollama-workshop-registry.service ollama-workshop-maven.service
After=ollama-workshop-registry.service ollama-workshop-maven.service

[Container]
Image=docker.io/library/nginx:1.30.6-alpine
ContainerName=ollama-workshop-downloads
Pod=ollama-workshop.pod
Pull=never
Volume=/mnt/ssd/ollama-workshop-registry/nginx.conf:/etc/nginx/nginx.conf:ro,Z
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/v2/
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900
