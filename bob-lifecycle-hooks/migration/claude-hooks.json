{
  "description": "Portable repository write policy",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_write.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

