{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(write_file|apply_diff|search_and_replace|insert_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .bob/hooks/guard_write.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
